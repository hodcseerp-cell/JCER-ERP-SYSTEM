{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@controllers/*": ["src/controllers/*"],
      "@services/*": ["src/services/*"],
      "@models/*": ["src/models/*"],
      "@routes/*": ["src/routes/*"],
      "@middleware/*": ["src/middleware/*"],
      "@validators/*": ["src/validators/*"],
      "@utils/*": ["src/utils/*"],
      "@types/*": ["src/types/*"],
      "@constants/*": ["src/constants/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/controllers/student.controller.ts",
    "src/controllers/teacher.controller.ts",
    "src/controllers/hod.controller.ts",
    "src/controllers/parent.controller.ts",
    "src/controllers/fee.controller.ts",
    "src/controllers/grievance.controller.ts",
    "src/controllers/library.controller.ts",
    "src/controllers/placement.controller.ts",
    "src/controllers/hostel.controller.ts",
    "src/controllers/assignment.controller.ts",
    "src/controllers/attendance.controller.ts",
    "src/controllers/document.controller.ts",
    "src/controllers/exam.controller.ts",
    "src/controllers/marks.controller.ts",
    "src/controllers/material.controller.ts",
    "src/controllers/message.controller.ts",
    "src/controllers/performance.controller.ts",
    "src/controllers/report.controller.ts",
    "src/controllers/timetable.controller.ts",
    "src/routes/student.routes.ts",
    "src/routes/teacher.routes.ts",
    "src/routes/hod.routes.ts",
    "src/routes/parent.routes.ts",
    "src/routes/fee.routes.ts",
    "src/routes/grievance.routes.ts",
    "src/routes/assignment.routes.ts",
    "src/routes/attendance.routes.ts",
    "src/routes/document.routes.ts",
    "src/routes/exam.routes.ts",
    "src/routes/marks.routes.ts",
    "src/routes/material.routes.ts",
    "src/routes/message.routes.ts",
    "src/routes/performance.routes.ts",
    "src/routes/report.routes.ts",
    "src/routes/timetable.routes.ts",
    "src/services/student.service.ts",
    "src/services/fee.service.ts",
    "src/services/grievance.service.ts",
    "src/services/attendance.service.ts",
    "src/services/document.service.ts",
    "src/services/email.service.ts",
    "src/services/exam.service.ts",
    "src/services/file.service.ts",
    "src/services/marks.service.ts",
    "src/services/message.service.ts",
    "src/services/notification.service.ts",
    "src/services/payment.service.ts",
    "src/services/performance.service.ts",
    "src/services/report.service.ts",
    "src/services/sms.service.ts",
    "src/services/teacher.service.ts",
    "src/services/timetable.service.ts"
  ]
}